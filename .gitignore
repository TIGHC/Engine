# User data now lives in %APPDATA%\TIGHC (or ~/.local/share/TIGHC on Linux).
# These repo-root dirs may exist on older installs - keep them gitignored.
configs/
artwork_cache/

# Generated, not source
__pycache__/
*.pyc

# pytest, and PyInstaller build output (build/ and dist/) - see
# tighc-gui.spec, build.sh/build.bat, and .github/workflows/ci.yml for how
# these are (re)built; nothing under either should ever be committed.
.pytest_cache/
build/
dist/
*.egg-info/
