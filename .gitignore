# User data now lives in %APPDATA%\TIGHC (or ~/.local/share/TIGHC on Linux).
# This repo-root dir may exist on older installs - keep it gitignored.
configs/

# Generated, not source
__pycache__/
*.pyc

# Local virtualenv - everyone creates their own, see CONTRIBUTING.md
.venv/

# pytest, and PyInstaller build output (build/ and dist/, including the
# .spec file PyInstaller itself generates into build/) - see
# src/build/create_release_files.py and .github/workflows/ci.yml for how
# these are (re)built; nothing under either should ever be committed.
# Anchored to the repo root so this doesn't also swallow the src/build/
# package itself.
.pytest_cache/
/build/
/dist/
*.egg-info/
